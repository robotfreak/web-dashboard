[Unit]
Description=Web Dashboard — Self-Hosted Services Web UI
Documentation=https://github.com/robotfreak/web-dashboard
After=network.target

[Service]
Type=simple
User=pi
Group=pi

# ===== ANPASSEN: Pfade auf dein Projekt =====
WorkingDirectory=/home/pi/ki-os/web-dashboard
# WorkingDirectory=/path/to/dein/projekt/web-dashboard

ExecStart=/home/pi/ki-os/web-dashboard/venv/bin/python app.py
# ExecStart=/path/to/dein/projekt/web-dashboard/venv/bin/python app.py

Restart=always
RestartSec=5
TimeoutSec=30

# Security Hardening (optional)
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=web-dashboard

[Install]
WantedBy=default.target
